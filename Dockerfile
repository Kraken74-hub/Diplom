# Используем компактный официальный образ Python 3.11
FROM python:3.11-slim

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем список зависимостей и устанавливаем их без сохранения кэша (для уменьшения размера образа)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем весь исходный код проекта
COPY . .

# Команда по умолчанию при запуске основного контейнера — запуск Telegram-бота
CMD ["python", "main.py"]